{
  "name": "blueprintai-functions",
  "description": "Firebase Cloud Functions for BlueprintAI PRD generation",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "18"
  },
  "main": "lib/index.js",
  "dependencies": {
    "axios": "^1.6.7",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "pdfkit": "^0.14.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pdfkit": "^0.17.5",
    "typescript": "^5.3.3"
  },
  "private": true
}
